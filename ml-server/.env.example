# ML Server Runtime
PORT=8000
CORS_ORIGIN=*

# ── Primary: Resinix AI ──────────────────────────────────
RESINIX_API_KEY=your_resinix_api_key_here
RESINIX_API_URL=https://api.resinix.ai/v1/chat/completions

# ── Fallback: Google AI Studio ───────────────────────────
# Used automatically when Resinix is unreachable or returns 5xx.
# Get a free key at: https://aistudio.google.com/apikey
# Use gemini-2.5-flash — gemini-2.0-flash free-tier quota may be 0 on some projects
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
